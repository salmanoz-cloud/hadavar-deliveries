# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Meshulam Payment Configuration
REACT_APP_MESHULAM_MERCHANT_ID=your_merchant_id
MESHULAM_API_KEY=your_api_key_here

# WhatsApp Bot Configuration
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_BOT_NUMBER=972123456789
WHATSAPP_PROVIDER=twilio # or wati, 360dialog

# AI/LLM Configuration
AI_PROVIDER=openai # or google
AI_API_KEY=your_ai_api_key
AI_MODEL=gpt-4-mini # or gemini-1.5-flash

# FCM Configuration
FCM_SERVER_KEY=your_fcm_server_key

# Application Configuration
REACT_APP_APP_NAME=הדוור הבא
REACT_APP_APP_LOGO=https://your-domain.com/logo.png
REACT_APP_API_URL=http://localhost:5000
REACT_APP_ENVIRONMENT=development # or production

# Node Environment
NODE_ENV=development # or production

